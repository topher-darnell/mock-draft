{
  "name": "bigheadgm-ios",
  "version": "1.0.0",
  "private": true,
  "description": "Big Head GM for iPhone: the bigheadgm.com site in a native app shell (Capacitor).",
  "scripts": {
    "setup": "bash setup-mac.sh",
    "sync": "npx cap sync ios",
    "open": "npx cap open ios",
    "assets": "npx capacitor-assets generate --ios --iconBackgroundColor '#10151C' --splashBackgroundColor '#10151C' --splashBackgroundColorDark '#10151C'"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@capacitor/assets": "^3.0.5"
  }
}
